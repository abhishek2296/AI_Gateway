# PostgreSQL container
POSTGRES_DB=ai_coding_assistant
POSTGRES_USER=ai_app
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432

# Application server
HOST=0.0.0.0
PORT=8000
APP_PORT=8000

# Database URL
# Local (app on host): use localhost
DATABASE_URL=postgresql+asyncpg://ai_app:replace-with-a-local-development-password@localhost:5432/ai_coding_assistant
# Docker Compose (api container): compose overrides host to postgres — example for reference:
# DATABASE_URL=postgresql+asyncpg://ai_app:replace-with-a-local-development-password@postgres:5432/ai_coding_assistant

TEST_DATABASE_URL=postgresql+asyncpg://ai_app:replace-with-a-local-development-password@localhost:5432/ai_coding_assistant_test
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Ollama (optional — run on host when using Docker)
OLLAMA_HOST=http://localhost:11434
# Docker Compose: use host.docker.internal to reach Ollama on the host machine
# OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b

# Provider defaults (database-backed resolution planned for a later phase)
DEFAULT_PROVIDER=ollama
DEFAULT_MODEL=qwen3:8b
PROVIDER_RESOLUTION_CACHE_TTL_SECONDS=60

# Provider HTTP retry and model cache (Phase 5)
PROVIDER_HTTP_MAX_RETRIES=3
PROVIDER_HTTP_RETRY_BASE_DELAY_SECONDS=0.5
PROVIDER_HTTP_RETRY_MAX_DELAY_SECONDS=8.0
PROVIDER_MODEL_LIST_CACHE_TTL_SECONDS=300
ANTHROPIC_API_VERSION=2023-06-01

# Cloud provider API keys (set via DB api_key_env in production; examples for local dev)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
